{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://incident/monotonic-anchor/v1",
  "title": "Crowsi Fresh Monotonic Anchor Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "anchor_id",
    "jti",
    "deployment_id",
    "incident_id",
    "challenge_nonce",
    "sequence",
    "checkpoint_digest",
    "issued_at",
    "expires_at",
    "authority",
    "signed"
  ],
  "properties": {
    "schema": { "const": "crowsi://incident/monotonic-anchor/v1" },
    "anchor_id": { "$ref": "#/$defs/identifier" },
    "jti": { "$ref": "#/$defs/identifier" },
    "deployment_id": { "$ref": "#/$defs/identifier" },
    "incident_id": { "$ref": "#/$defs/identifier" },
    "challenge_nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "sequence": { "type": "integer", "minimum": 1 },
    "checkpoint_digest": { "$ref": "#/$defs/digest" },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "authority": { "$ref": "#/$defs/identifier" },
    "signed": { "$ref": "#/$defs/signed" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "digest", "signature"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
