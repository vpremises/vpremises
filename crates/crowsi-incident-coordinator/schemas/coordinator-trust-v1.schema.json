{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://incident/coordinator-trust/v1",
  "title": "Crowsi Coordinator Pinned Trust v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deployment_id", "revision", "keys"],
  "properties": {
    "schema": { "const": "crowsi://incident/coordinator-trust/v1" },
    "deployment_id": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/key" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "key_id", "role", "scopes", "public_key"],
      "properties": {
        "authority": { "type": "string", "minLength": 1, "maxLength": 512 },
        "key_id": { "$ref": "#/$defs/identifier" },
        "role": {
          "enum": [
            "pep",
            "independent-verifier",
            "recovery-authority",
            "incident-owner",
            "identity-provider",
            "policy-administrator",
            "checkpoint-authority",
            "anchor-authority"
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "containment",
              "restore",
              "recovery",
              "monitoring",
              "incident-lifecycle",
              "checkpoint",
              "anchor"
            ]
          }
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    }
  }
}
