{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://network/boundary-snapshot/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "external_actions",
    "overall_status",
    "summary",
    "environments"
  ],
  "properties": {
    "schema": { "const": "crowsi://network/boundary-snapshot/v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "external_actions": { "const": false },
    "overall_status": { "enum": ["healthy", "attention", "unknown"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_count", "healthy_count", "attention_count", "unknown_count"],
      "properties": {
        "environment_count": { "type": "integer", "minimum": 1 },
        "healthy_count": { "type": "integer", "minimum": 0 },
        "attention_count": { "type": "integer", "minimum": 0 },
        "unknown_count": { "type": "integer", "minimum": 0 }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/environment" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "provider",
        "source",
        "status",
        "isolation_mode",
        "isolation_verified",
        "project_count",
        "network_count",
        "instance_count",
        "public_ingress",
        "finding_codes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/id" },
        "status": { "enum": ["healthy", "attention", "unknown"] },
        "isolation_mode": { "$ref": "#/$defs/id" },
        "isolation_verified": { "type": "boolean" },
        "project_count": { "type": "integer", "minimum": 0 },
        "network_count": { "type": "integer", "minimum": 0 },
        "instance_count": { "type": "integer", "minimum": 0 },
        "public_ingress": { "type": "boolean" },
        "finding_codes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
